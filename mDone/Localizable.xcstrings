    "Follows" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "后于"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folgt auf"
          }
        }
      }
    },
    "For projects you share with other people in Vikunja. Shows who each task is assigned to, lets you assign people when adding or editing a task, and adds an Assigned to me filter. Leave it off if you use mDone on your own." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于你在 Vikunja 中与他人共享的项目。显示每个任务的负责人，可在添加或编辑任务时指派成员，并新增“指派给我的”筛选。如果你只是个人使用 mDone，请保持关闭。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Projekte, die du in Vikunja mit anderen teilst. Zeigt, wer für eine Aufgabe zuständig ist, lässt dich beim Hinzufügen oder Bearbeiten Personen zuweisen und ergänzt den Filter „Mir zugewiesen“. Lass es aus, wenn du mDone allein nutzt."
          }
        }
      }
    },
