          }
        }
      }
    },
    "Focus sessions sync automatically when you complete a task. The server uses each session's client_id for idempotent retry, so re-sending the same session never creates duplicates." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成任务时，专注记录会自动同步。服务器使用每次记录的 client_id 进行幂等重试，因此重复发送同一记录不会产生重复数据。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokussitzungen werden automatisch synchronisiert, wenn du eine Aufgabe erledigst. Der Server erkennt jede Sitzung an ihrer client_id, daher entstehen beim erneuten Senden derselben Sitzung keine Duplikate."
          }
        }
      }
    },
