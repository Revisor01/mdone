        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat Probleme. Bitte versuche es gleich noch einmal."
          }
        }
      }
    },
    "The server is rate limiting requests. Wait a moment and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器限制了请求频率，请稍候再试。"
